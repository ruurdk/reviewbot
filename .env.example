# ---------------------------------------------------------------------------
# reviewbot credentials -- EXAMPLE FILE, safe to commit. Do not put real
# secrets in this file.
#
# Setup:
#
#   cp .env.example .env
#   $EDITOR .env                     # fill in the four real values
#   python3 -m reviewbot doctor      # confirms what is still missing
#
# .env is gitignored. Every command loads it automatically at startup, and the
# real environment always wins -- an exported shell variable overrides the
# file, so `ANTHROPIC_API_KEY=sk-... python3 -m reviewbot run x` works for a
# one-off without editing anything.
#
# Prefer not to keep a file at all? Source it into the shell instead:
#
#   set -a; source .env; set +a
#
# Nothing here is needed to run the tests -- `python3 -m unittest discover -s
# tests -t .` uses injected transports and never touches the network.
# ---------------------------------------------------------------------------


# --- Claude API ------------------------------------------------------------
# Needed by: run
#
# The reviewer itself. This is what makes the token accounting first-party and
# exact: every response carries a `usage` object we read directly. The harness
# refuses to estimate tokens when this is absent rather than quietly producing
# numbers that cannot be defended.
#
# Get one at: https://console.anthropic.com/settings/keys
# Cost note: the frozen sequence is ~20 PRs x 2 agents at claude-opus-5
# ($5/$25 per MTok) plus the primer. Start with `run --agents baseline` over a
# short sequence to size it before committing to a full run.
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME


# --- GitHub ----------------------------------------------------------------
# Needed by: ingest
#
# PR metadata, file lists, patches, and review comments. A fine-grained token
# with public-repo read access is enough -- redis/redis-py is public, so no
# write or private scopes are required.
#
# Not optional: the unauthenticated limit is 60 requests/hour, and one PR costs
# 4 requests (pr + files + comments + reviews). 20 PRs exhausts it immediately.
# Responses are cached to data/cache/github/ keyed by URL, so a re-run of
# `ingest` makes zero requests.
#
# Create at: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=github_pat_REPLACE_ME


# --- Redis Agent Memory (managed, in Redis Iris) ----------------------------
# Needed by: run --agents memory (and the default, run --agents both)
#
# The memory substrate under test. Create an Agent Memory store in the Redis
# Iris console, then register the three custom memory types the demo uses --
# repo_convention, review_finding, review_policy -- before the first run
# (spec §10 step 2).
#
# VERIFY THESE TWO AGAINST THE CONSOLE. The published OpenAPI for Agent Memory
# declares no `servers` block and no `securitySchemes`, so the base URL shape
# and the auth header are the one part of this integration that is inferred
# rather than documented. reviewbot/memory.py currently sends
# `Authorization: Bearer $REDIS_AGENT_MEMORY_API_KEY` and builds paths as
# {URL}/v1/stores/{STORE_ID}/long-term-memory. If the console shows something
# different, fix `_headers()` / `_url()` there -- it is deliberately the only
# place that knows. The service is in preview: pin the version you used and
# re-verify the surface before the demo is shown.

# Base URL of the Agent Memory service, no trailing slash and no /v1 suffix.
REDIS_AGENT_MEMORY_URL=https://REPLACE_ME.agent-memory.redis.io

# API key for that store.
REDIS_AGENT_MEMORY_API_KEY=REPLACE_ME

# Store id, as shown in the console. Also settable per run with --store-id.
REDIS_AGENT_MEMORY_STORE_ID=REPLACE_ME


# --- Optional run defaults --------------------------------------------------
# Not credentials; every one of these is also a CLI flag.
#
# Per-run memory namespace. Bump it for each experiment run so a rerun starts
# from a clean store and cannot read the previous run's memories. Dashes and
# alphanumerics only -- the service rejects `redis-py/run-2` (see spec §4d).
REVIEWBOT_NAMESPACE=redis-py-run-1
