{
  "name": "reviewbot-replay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Replay page for the agentic-memory PR-review demo (spec 8a)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
