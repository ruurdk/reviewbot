  },
  "dependencies": {
    "@redis-ui/components": "51.2.0",
    "@redis-ui/styles": "21.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "vite": "^6.0.7"
  }
}
